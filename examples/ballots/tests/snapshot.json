{
  "commands": {
    "description": "ballots commands",
    "name": "ballots",
    "options": [
      {
        "description": "Delete a ballot and its votes.",
        "name": "delete",
        "options": [
          {
            "description": "The ballot's number, from /ballots list.",
            "name": "ballot",
            "required": true,
            "type": 4
          }
        ],
        "type": 1
      },
      {
        "description": "The running ballots.",
        "name": "list",
        "options": [],
        "type": 1
      },
      {
        "description": "Start a ballot.",
        "name": "start",
        "options": [
          {
            "description": "Where to post the ballot.",
            "name": "channel",
            "required": true,
            "type": 7
          },
          {
            "description": "What the ballot asks.",
            "max_length": 200,
            "name": "question",
            "required": true,
            "type": 3
          },
          {
            "description": "The first option.",
            "max_length": 100,
            "name": "option_1",
            "required": true,
            "type": 3
          },
          {
            "description": "The second option.",
            "max_length": 100,
            "name": "option_2",
            "required": true,
            "type": 3
          },
          {
            "description": "A third option.",
            "max_length": 100,
            "name": "option_3",
            "required": false,
            "type": 3
          },
          {
            "description": "A fourth option.",
            "max_length": 100,
            "name": "option_4",
            "required": false,
            "type": 3
          },
          {
            "description": "How long it runs; the server's default if left out.",
            "max_value": 10080,
            "min_value": 1,
            "name": "minutes",
            "required": false,
            "type": 4
          }
        ],
        "type": 1
      },
      {
        "description": "Vote in a running ballot, or change your vote.",
        "name": "vote",
        "options": [
          {
            "description": "The ballot's number, from /ballots list.",
            "name": "ballot",
            "required": true,
            "type": 4
          },
          {
            "description": "The number of the option you choose.",
            "max_value": 4,
            "min_value": 1,
            "name": "option",
            "required": true,
            "type": 4
          }
        ],
        "type": 1
      }
    ],
    "type": 1
  },
  "jobs": {
    "close": {
      "properties": {
        "ballot": {
          "title": "Ballot",
          "type": "integer"
        }
      },
      "required": [
        "ballot"
      ],
      "title": "BallotsCloseInput",
      "type": "object"
    }
  },
  "tools": {
    "ballots_delete": {
      "properties": {
        "ballot": {
          "description": "The ballot's number, from /ballots list.",
          "title": "Ballot",
          "type": "integer"
        },
        "confirm": {
          "description": "The confirm value of a plan this tool returned. Leave it out to get a plan.",
          "type": "string"
        }
      },
      "required": [
        "ballot"
      ],
      "title": "BallotsDeleteInput",
      "type": "object"
    },
    "ballots_list": {
      "properties": {},
      "title": "BallotsListInput",
      "type": "object"
    },
    "ballots_start": {
      "$defs": {
        "Choice": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        }
      },
      "properties": {
        "channel": {
          "description": "Where to post the ballot.",
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Channel",
          "type": "string"
        },
        "minutes": {
          "anyOf": [
            {
              "maximum": 10080,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How long it runs; the server's default if left out.",
          "title": "Minutes"
        },
        "option_1": {
          "$ref": "#/$defs/Choice",
          "description": "The first option."
        },
        "option_2": {
          "$ref": "#/$defs/Choice",
          "description": "The second option."
        },
        "option_3": {
          "anyOf": [
            {
              "$ref": "#/$defs/Choice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A third option."
        },
        "option_4": {
          "anyOf": [
            {
              "$ref": "#/$defs/Choice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A fourth option."
        },
        "question": {
          "description": "What the ballot asks.",
          "maxLength": 200,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "question",
        "option_1",
        "option_2"
      ],
      "title": "BallotsStartInput",
      "type": "object"
    },
    "ballots_vote": {
      "properties": {
        "ballot": {
          "description": "The ballot's number, from /ballots list.",
          "title": "Ballot",
          "type": "integer"
        },
        "option": {
          "description": "The number of the option you choose.",
          "maximum": 4,
          "minimum": 1,
          "title": "Option",
          "type": "integer"
        }
      },
      "required": [
        "ballot",
        "option"
      ],
      "title": "BallotsVoteInput",
      "type": "object"
    }
  }
}
